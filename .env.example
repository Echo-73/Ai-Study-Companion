# AI Study Companion - Backend Environment Variables Example
# Copy this file to backend/.env (or set these in your hosting environment dashboard)

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL with SSL for production)
# Example for Neon/Supabase: postgresql://user:password@ep-xyz-pooler.region.neon.tech/ai_study_companion?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/ai_study_companion?schema=public"
# Direct connection for Prisma Migrations (Neon non-pooler connection without -pooler)
# Example for Neon: postgresql://user:password@ep-xyz.region.neon.tech/ai_study_companion?sslmode=require
DIRECT_DATABASE_URL="postgresql://username:password@localhost:5432/ai_study_companion?schema=public"

# Authentication Secrets
# Generate a secure 64-character secret using: openssl rand -base64 48
JWT_SECRET="replace-with-a-very-long-random-secret-key"
JWT_EXPIRES_IN="7d"

# Google Gemini API
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY="your gemini api key"
GEMINI_MODEL="gemini-3.6-flash"

# CORS & Allowed Origins
# The URL of your deployed frontend (e.g. https://my-study-companion.vercel.app)
FRONTEND_URL="http://localhost:5173"

# Persistent Storage Directory for PDFs (defaults to ./uploads)
UPLOADS_DIR="./uploads"
